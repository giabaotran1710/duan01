{
  "rules": {
    ".read": false,
    ".write": false,
    "activity": {
      ".read": true,
      "$day": {
        ".write": "!newData.exists()",
        ".validate": "$day.matches(/^20[0-9]{6}$/)",
        "$id": {
          ".write": "!data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['u', 'n', 'g', 't'])",
          "u": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{24,40}$/)"
          },
          "n": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
          },
          "g": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
          },
          "t": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000 && newData.val() >= now - 60000"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "names": {
      "$name": {
        ".read": true,
        ".write": "!data.exists() && newData.exists()",
        ".validate": "$name.matches(/^[a-z0-9]{6,10}$/) && newData.isString() && newData.val().matches(/^[a-f0-9]{24,40}$/)"
      }
    },
    "leaderboards": {
      "$game": {
        ".read": true,
        ".indexOn": [
          "score"
        ],
        ".validate": "$game.matches(/^[a-z0-9_]{1,30}$/)",
        "$uid": {
          ".write": "newData.exists() && (!data.exists() || newData.child('score').val() >= data.child('score').val())",
          ".validate": "$uid.matches(/^[a-f0-9]{24,40}$/) && newData.hasChildren(['name', 'score', 'at']) && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 20 && (newData.child('name').val() == 'Người chơi' || root.child('names/' + newData.child('name').val()).val() == $uid) && newData.child('score').isNumber() && newData.child('score').val() >= 0 && newData.child('score').val() <= 10000000 && newData.child('at').isNumber() && newData.child('at').val() <= now + 60000",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
          },
          "score": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
          },
          "at": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
          }
        }
      }
    },
    "caro_rooms": {
      "$code": {
        ".read": true,
        ".write": "!data.exists() || !newData.exists()",
        ".validate": "$code.matches(/^[A-HJ-NP-Z2-9]{5}$/) && newData.hasChild('host')",
        "created": {
          ".validate": "newData.isNumber()"
        },
        "host": {
          ".write": "!data.exists()",
          ".validate": "newData.hasChildren(['id', 'name', 'seen'])",
          "id": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{24}$/)"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
          },
          "seen": {
            ".write": true,
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "guest": {
          ".write": "!data.exists() || !newData.exists()",
          ".validate": "newData.hasChildren(['id', 'name', 'seen'])",
          "id": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{24}$/)"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
          },
          "seen": {
            ".write": true,
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "round": {
          ".write": "newData.exists() && root.child('caro_rooms/' + $code + '/rounds/' + newData.val()).exists()",
          ".validate": "newData.isString() && newData.val().matches(/^g[0-9]{1,3}$/)"
        },
        "rounds": {
          "$g": {
            ".write": "!data.exists()",
            ".validate": "$g.matches(/^g[0-9]{1,3}$/) && newData.hasChild('xHost') && newData.child('xHost').isBoolean()",
            "xHost": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "moves": {
          "$g": {
            "$m": {
              ".write": "!data.exists()",
              ".validate": "$m.matches(/^m[0-9]{1,3}$/) && newData.hasChildren(['n', 'r', 'c', 'p', 'u']) && newData.child('n').isNumber() && newData.child('n').val() >= 0 && newData.child('n').val() <= 624 && newData.child('r').isNumber() && newData.child('r').val() >= 0 && newData.child('r').val() <= 24 && newData.child('c').isNumber() && newData.child('c').val() >= 0 && newData.child('c').val() <= 24 && (newData.child('p').val() == 'X' || newData.child('p').val() == 'O') && newData.child('n').val() % 2 == (newData.child('p').val() == 'X' ? 0 : 1) && newData.child('u').val() == (((newData.child('p').val() == 'X') == root.child('caro_rooms/' + $code + '/rounds/' + $g + '/xHost').val()) ? root.child('caro_rooms/' + $code + '/host/id').val() : root.child('caro_rooms/' + $code + '/guest/id').val())",
              "n": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 624"
              },
              "r": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 24"
              },
              "c": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 24"
              },
              "p": {
                ".validate": "newData.val() == 'X' || newData.val() == 'O'"
              },
              "u": {
                ".validate": "newData.isString()"
              }
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
