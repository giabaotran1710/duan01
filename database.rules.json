        },
        "rounds": {
          "$g": {
            ".write": "!data.exists()",
            ".validate": "$g.matches(/^g[0-9]{1,3}$/) && newData.hasChild('seed')",
            "seed": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2147483647" },
            "$other": { ".validate": false }
          }
        },
        "prog": {
          "$g": {
            "$r": {
              ".write": true,
              ".validate": "($r == 'host' || $r == 'guest') && newData.hasChildren(['n', 'm'])",
              "n": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
              "m": { ".validate": "newData.isString() && newData.val().length <= 200 && newData.val().matches(/^[01]*$/)" },
              "$other": { ".validate": false }
            }
          }
        },
        "win": {
          "$g": {
            ".write": "!data.exists()",
            ".validate": "$g.matches(/^g[0-9]{1,3}$/) && newData.hasChild('r')",
            "r": { ".validate": "newData.val() == 'host' || newData.val() == 'guest'" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
